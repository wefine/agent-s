
# OPENROUTER
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_GROUNDING_MODEL=bytedance/ui-tars-1.5-7b

# CLI Configuration
ENABLE_LOCAL_ENV=True

# Main Model (使用 OpenRouter)
PROVIDER=open_router
MODEL=openai/gpt-4o-mini
MODEL_API_KEY=
# 如果使用 OpenRouter，不需要 MODEL_URL（会自动使用 https://openrouter.ai/api/v1）
# MODEL_URL=https://openrouter.ai/api/v1

# Grounding Model (使用 OpenRouter)
GROUND_PROVIDER=open_router
GROUND_URL=https://openrouter.ai/api/v1
GROUND_API_KEY=
GROUND_MODEL=bytedance/ui-tars-1.5-7b
GROUNDING_WIDTH=1920
GROUNDING_HEIGHT=1080